# Google AI Studio (Gemini) API Key
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_api_key_here

# App URL (for magic link generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode (shows phase switcher UI)
NEXT_PUBLIC_DEMO_MODE=true

# Authentication (OTP)
AUTH_SECRET=your-secret-key-min-32-chars

# Gmail SMTP (OTP送信用)
# Googleアカウント → セキュリティ → アプリパスワード で16桁を発行
GMAIL_USER=luminafujiadmin@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ═══════════════════════════════════════════════════════════════════════════
#  照明連携 (任意 — OLEDWorks Brite 3 / 電球色 3000K 固定)
#  Zigbee と DALI-2 の両方に対応。詳細手順: docs/LIGHTING_SETUP.md
# ═══════════════════════════════════════════════════════════════════════════

# 使用するバックエンド: auto | zigbee | dali | both | simulation
#   auto … 設定済みのものを自動採用（両方設定なら both）
#   どれも未設定 / 未到達ならシミュレーション動作（UIは反応／実機には送信しない）
LIGHTING_BACKEND=auto

# ── ① Zigbee2MQTT (MQTT 経由) ──────────────────────────────────────────────
# Zigbee2MQTT は MQTT で制御します（REST API は使いません）。
ZIGBEE_MQTT_URL=mqtt://192.168.1.50:1883
ZIGBEE_MQTT_USERNAME=lumina
ZIGBEE_MQTT_PASSWORD=
ZIGBEE_BASE_TOPIC=zigbee2mqtt
# ゾーン → Zigbee2MQTT friendly_name のマッピング (JSON)
# "all" は全灯を束ねる Zigbee グループの friendly_name
ZIGBEE_DEVICES={"all":"lumina_all","living":"lumina_living","bedroom":"lumina_bedroom","bathroom":"lumina_bathroom","entrance":"lumina_entrance"}

# ── ② DALI-2 (IP ゲートウェイへ HTTP) ──────────────────────────────────────
# Lunatone DALI-2 IoT 等の DALI-2 IP ゲートウェイの URL。
# DALI_GATEWAY_URL が未設定なら DALI は無効。
DALI_GATEWAY_URL=http://192.168.1.60
DALI_GATEWAY_TOKEN=
# コマンド/ヘルスチェックのパス (ゲートウェイに合わせて変更可)
DALI_COMMAND_PATH=/command
DALI_HEALTH_PATH=/status
# ゾーン → DALI アドレス指定のマッピング (JSON)
# 値の例: "broadcast" | "group:0" | "short:5"
DALI_DEVICES={"all":"broadcast","living":"group:0","bedroom":"group:1","bathroom":"group:2","entrance":"group:3"}
