# Google AI Studio (Gemini) API Key
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_api_key_here

# App URL (for magic link generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode (shows phase switcher UI)
NEXT_PUBLIC_DEMO_MODE=true

# Authentication (OTP)
AUTH_SECRET=your-secret-key-min-32-chars

# Gmail SMTP (OTP送信用)
# Googleアカウント → セキュリティ → アプリパスワード で16桁を発行
GMAIL_USER=luminafujiadmin@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Zigbee2MQTT Integration (optional — for real lighting control)
# Set ZIGBEE_BRIDGE_URL to your local Zigbee2MQTT frontend URL
# Without this, the app runs in simulation mode (UI works, lights don't change)
ZIGBEE_BRIDGE_URL=http://192.168.1.100:8080
ZIGBEE_API_TOKEN=

# Zone → Zigbee2MQTT device friendly name mapping (JSON)
# "all" maps to a Zigbee group controlling all lights at once
ZIGBEE_DEVICES={"all":"lumina_all","living":"lumina_living","bedroom":"lumina_bedroom","bathroom":"lumina_bathroom","entrance":"lumina_entrance"}
